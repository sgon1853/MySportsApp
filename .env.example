# Copy this file to .env and fill in real values before running docker compose.
# .env is gitignored — never commit real secrets.

# --- Postgres ---
POSTGRES_DB=mysportsapp
POSTGRES_USER=mysportsapp
POSTGRES_PASSWORD=change-me

# --- Backend ---
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/mysportsapp
SPRING_DATASOURCE_USERNAME=mysportsapp
SPRING_DATASOURCE_PASSWORD=change-me

# Any long random string (e.g. `openssl rand -base64 48`). Rotating it invalidates all issued tokens.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION_DAYS=7

# Bootstrapped on first backend startup if no ADMIN user exists yet.
ADMIN_BOOTSTRAP_EMAIL=you@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me

# --- Frontend ---
# Exposed host port for the nginx container serving the SPA.
FRONTEND_PORT=8081
