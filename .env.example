# Copy this file to .env and fill in real values before running docker compose.
# .env is gitignored — never commit real secrets.

# --- Postgres ---
POSTGRES_DB=mysportsapp
POSTGRES_USER=mysportsapp
POSTGRES_PASSWORD=change-me

# --- Backend ---
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/mysportsapp
SPRING_DATASOURCE_USERNAME=mysportsapp
SPRING_DATASOURCE_PASSWORD=change-me

# Any long random string (e.g. `openssl rand -base64 48`). Rotating it invalidates all issued tokens.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION_DAYS=7

# Bootstrapped on first backend startup if no ADMIN user exists yet.
ADMIN_BOOTSTRAP_EMAIL=you@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me

# --- Frontend ---
# Exposed host port for the nginx container serving the SPA.
FRONTEND_PORT=8081

# --- Strava integration (optional) ---
# Unset by default - connecting/syncing Strava returns a clear "not
# configured" error until these are set. See docs/usage.md's Strava section
# for how to register a Strava API app and get these values.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Generate with `openssl rand -base64 32` - do NOT reuse application.yml's
# checked-in default outside local dev; that key is public (it's in git).
STRAVA_TOKEN_ENCRYPTION_KEY=
# Must exactly match what's registered in the Strava app's own settings.
STRAVA_REDIRECT_URI=http://localhost:8081/api/v1/integrations/strava/callback
STRAVA_FRONTEND_URL=http://localhost:8081
