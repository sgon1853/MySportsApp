server {
    # ${PORT} is substituted by the base nginx image's docker-entrypoint.d
    # envsubst-on-templates step at container startup. Cloud Run injects PORT
    # dynamically; docker-compose/local runs set it to 80 (see Dockerfile).
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Static assets - allow long-lived caching.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Reverse proxy API calls to the backend (docker-compose service name
    # "backend:8080" by default - see BACKEND_UPSTREAM in the Dockerfile).
    # This must always be *something* nginx can resolve at startup, even on
    # deployments (Cloud Run) where this block is never actually hit because
    # the frontend calls the backend directly via an absolute URL instead -
    # nginx resolves a static proxy_pass hostname once at config load and
    # refuses to start at all if it can't, regardless of whether a request
    # ever reaches this location.
    location /api/ {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback - client-side routing (react-router) owns everything else.
    location / {
        try_files $uri /index.html;
    }
}
